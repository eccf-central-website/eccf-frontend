# eccf-frontend environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# See eccf-frontend CLAUDE.md Section 9 for secret handling rules.

# ---------------------------------------------------------------------------
# Sanity — Public (safe to expose to browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=ynnot4j0
NEXT_PUBLIC_SANITY_DATASET=production

# ---------------------------------------------------------------------------
# Sanity — Server-side write token (NEVER prefix with NEXT_PUBLIC_)
# Generate at: https://sanity.io/manage → project → API → Tokens
# Required permissions: Editor
# ---------------------------------------------------------------------------
SANITY_WRITE_TOKEN=

# Read token for the public sanityClient (lib/sanity.ts). Use a Viewer-role
# token. Optional while the dataset is public; REQUIRED once it is made private.
# Never falls back to SANITY_WRITE_TOKEN.
SANITY_READ_TOKEN=

# Shared secret for Sanity's signed announcement webhook
# (app/api/webhooks/announcement). Must match the "Secret" field of the webhook
# in sanity.io/manage → API → Webhooks. The route rejects all calls when unset.
SANITY_WEBHOOK_SECRET=

# Token for /announcements/preview, which shows unpublished drafts. Without an
# admin dashboard session the page 404s unless ?preview=<this value> matches.
# Prince must append &preview=<this value> to the Studio preview-pane URL
# (eccf-backend components/WebPreviewPane.tsx). Server-only; generate with
# openssl rand -base64 32. When unset, only admin sessions can preview.
ANNOUNCEMENT_PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# NextAuth — Server-side only (NEVER prefix with NEXT_PUBLIC_)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# The app refuses to start sessions when neither NEXTAUTH_SECRET nor
# AUTH_SECRET is set. There is no built-in default.
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Field-level encryption (lib/encryption.ts) — Server-side only
# Generate each with: openssl rand -base64 32
# ENCRYPTION_KEY falls back to NEXTAUTH_SECRET; HMAC_PEPPER falls back to
# ENCRYPTION_KEY, then NEXTAUTH_SECRET. Existing ciphertext and phone blind
# indexes were created with whichever was set at the time, so DO NOT set or
# change these on an environment with data without re-encrypting
# (scripts/encrypt-existing-data.mjs).
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=
HMAC_PEPPER=

# ---------------------------------------------------------------------------
# Vercel Cron — bearer token for /api/sync-sermons. Vercel sends
# "Authorization: Bearer $CRON_SECRET" automatically when this is set.
# The route rejects all calls when unset.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Flutterwave — Server-side only (NEVER prefix with NEXT_PUBLIC_)
# Keys available at: https://dashboard.flutterwave.com
# ---------------------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=
# Public key IS safe for the browser (used in checkout modal)
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Multi-Platform Podcast & Sermon Sync (ADR-002)
# ---------------------------------------------------------------------------
SPOTIFY_RSS_URL=
YOUTUBE_RSS_URL=

# Resend Email API Key (Get free at resend.com)
RESEND_API_KEY="re_..."
NOTIFY_EMAIL="admin@eccf.com"

# ---------------------------------------------------------------------------
# Exco Dashboard — local development switches (ignored in production)
# ---------------------------------------------------------------------------
# 1 = use a mock session (role picked via the eccf-dev-role cookie, default admin)
# until NextAuth is configured. Never takes effect when NODE_ENV=production.
DASHBOARD_MOCK_AUTH=1
# mock | sanity — defaults to mock in development, sanity in production
DASHBOARD_DATA_SOURCE=mock
# Optional: empty | error | slow — exercise dashboard UI states with mock data
DASHBOARD_MOCK_STATE=
