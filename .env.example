# eccf-frontend environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# See eccf-frontend CLAUDE.md Section 9 for secret handling rules.
# No secret below has a built-in default: features that need one refuse to run
# (or the app throws a clear "[env] Missing secret" error) when it is unset.

# ---------------------------------------------------------------------------
# Sanity — Public (safe to expose to browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=ynnot4j0
NEXT_PUBLIC_SANITY_DATASET=production

# ---------------------------------------------------------------------------
# Sanity — server-side tokens (NEVER prefix either with NEXT_PUBLIC_)
# Generate tokens at: https://sanity.io/manage → project → API → Tokens
# SANITY_READ_TOKEN: Viewer role. Used by the public-content and draft-preview
#   clients (lib/sanity.ts). REQUIRED while the dataset is private. These
#   clients never fall back to SANITY_WRITE_TOKEN.
# SANITY_WRITE_TOKEN: Editor role. Server-side mutations and private reads only.
# ---------------------------------------------------------------------------
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=

# Shared secret for Sanity's signed announcement webhook
# (app/api/webhooks/announcement). Must match the "Secret" field of the webhook
# in sanity.io/manage → API → Webhooks (Sanity then sends the
# sanity-webhook-signature header). 32+ bytes. The route refuses every call
# when unset.
SANITY_WEBHOOK_SECRET=

# Draft preview (Sanity Studio preview pane). Draft mode can only be enabled
# through /api/preview?secret=<this value>&slug=/path. The Studio pane URLs
# must go through that route. /announcements/preview additionally accepts an
# admin dashboard session. 32+ bytes, server-only. When unset, draft preview is
# disabled for everyone except admins on /announcements/preview.
SANITY_PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# Encryption (lib/encryption.ts) — server-side only; independent random values
# (32+ bytes, e.g. openssl rand -base64 32).
# ENCRYPTION_KEY falls back to NEXTAUTH_SECRET; HMAC_PEPPER falls back to
# ENCRYPTION_KEY, then NEXTAUTH_SECRET. Keep legacy values only during a
# planned re-encryption (scripts/encrypt-existing-data.mjs).
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=
HMAC_PEPPER=
ENCRYPTION_LEGACY_KEYS=
HMAC_LEGACY_PEPPERS=

# ---------------------------------------------------------------------------
# NextAuth — Server-side only (NEVER prefix with NEXT_PUBLIC_)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32 (32+ bytes in production)
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Vercel Cron — bearer token for /api/sync-sermons. Vercel sends
# "Authorization: Bearer $CRON_SECRET" automatically. 32+ bytes. The route
# refuses every call when unset.
CRON_SECRET=

# Free Cloudflare Turnstile keys. Server actions fail closed in production when missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Private server-side Google Apps Script bridge URL; never use NEXT_PUBLIC_ here.
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
# Match this value to the Apps Script Project Property named UPLOAD_HMAC_SECRET.
GOOGLE_APPS_SCRIPT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Multi-Platform Podcast & Sermon Sync (ADR-002)
# ---------------------------------------------------------------------------
SPOTIFY_RSS_URL=
YOUTUBE_RSS_URL=

# Resend Email API Key (Get free at resend.com)
RESEND_API_KEY="re_..."
NOTIFY_EMAIL="admin@eccf.com"

# ---------------------------------------------------------------------------
# Exco Dashboard — local development switches (ignored in production)
# ---------------------------------------------------------------------------
# 1 = use a mock session (role picked via the eccf-dev-role cookie, default admin)
# until NextAuth is configured. Never takes effect when NODE_ENV=production.
DASHBOARD_MOCK_AUTH=1
# mock | sanity — defaults to mock in development, sanity in production
DASHBOARD_DATA_SOURCE=mock
# Optional: empty | error | slow — exercise dashboard UI states with mock data
DASHBOARD_MOCK_STATE=
