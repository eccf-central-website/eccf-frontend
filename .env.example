# eccf-frontend environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# See eccf-frontend CLAUDE.md Section 9 for secret handling rules.

# ---------------------------------------------------------------------------
# Sanity â€” Public (safe to expose to browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=ynnot4j0
NEXT_PUBLIC_SANITY_DATASET=production

# ---------------------------------------------------------------------------
# Sanity â€” server-side tokens (NEVER prefix either with NEXT_PUBLIC_)
# SANITY_READ_TOKEN should have read access and is used only for private draft reads.
# SANITY_WRITE_TOKEN is used for server-side mutations; keep it out of browser code.
# Generate tokens at: https://sanity.io/manage â†’ project â†’ API â†’ Tokens
# ---------------------------------------------------------------------------
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Encryption â€” server-side only; use independent random values (32+ bytes)
# Keep legacy values here only during a planned data re-encryption/key migration.
#
# IMPORTANT: Local and production MUST use the same ENCRYPTION_KEY and
# HMAC_PEPPER. If either environment previously used a different value, add
# that old value to the comma-separated legacy lists below so existing records
# remain readable. Never rotate a key without adding it here first.
#
# Example after unifying:
#   ENCRYPTION_LEGACY_KEYS=<old-local-key>,<old-production-key>
#   HMAC_LEGACY_PEPPERS=<old-local-pepper>,<old-production-pepper>
#
# Run `node scripts/check-encryption-health.mjs` to verify every field is readable.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=
HMAC_PEPPER=
ENCRYPTION_LEGACY_KEYS=
HMAC_LEGACY_PEPPERS=

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Clerk Authentication (ADR-003) â€” Google OAuth & Emailed OTP (No Passwords)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# NextAuth â€” Server-side only (NEVER prefix with NEXT_PUBLIC_)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Required to authorize scheduled sermon sync and the announcement webhook.
CRON_SECRET=
SANITY_WEBHOOK_SECRET=

# Free Cloudflare Turnstile keys. Server actions fail closed in production when missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Private server-side Google Apps Script bridge URL; never use NEXT_PUBLIC_ here.
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
# Match this value to the Apps Script Project Property named UPLOAD_HMAC_SECRET.
GOOGLE_APPS_SCRIPT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Multi-Platform Podcast & Sermon Sync (ADR-002)
# ---------------------------------------------------------------------------
# Default Spotify (Anchor) RSS: https://anchor.fm/s/f24b9b94/podcast/rss
SPOTIFY_RSS_URL=https://anchor.fm/s/f24b9b94/podcast/rss
# Default YouTube Playlist RSS (ECCF Messages Podcast): https://www.youtube.com/feeds/videos.xml?playlist_id=PLBI5gIAk9TVM
YOUTUBE_RSS_URL=https://www.youtube.com/feeds/videos.xml?playlist_id=PLBI5gIAk9TVM

# Resend Email API Key (Get free at resend.com)
RESEND_API_KEY="re_..."
# IMPORTANT: onboarding@resend.dev can only deliver to the Resend account owner.
# Verify a domain at https://resend.com/domains and use an address on it, e.g.
# RESEND_FROM_EMAIL="ECCF Workforce <no-reply@your-verified-domain.org>"
RESEND_FROM_EMAIL=""
NOTIFY_EMAIL="admin@eccf.com"

# ---------------------------------------------------------------------------
# Exco Dashboard â€” local development switches (ignored in production)
# ---------------------------------------------------------------------------
# 1 = use a mock session (role picked via the eccf-dev-role cookie, default admin)
# until NextAuth is configured. Never takes effect when NODE_ENV=production.
DASHBOARD_MOCK_AUTH=1
# mock | sanity â€” defaults to mock in development, sanity in production
DASHBOARD_DATA_SOURCE=mock
# Optional: empty | error | slow â€” exercise dashboard UI states with mock data
DASHBOARD_MOCK_STATE=
