# eccf-frontend environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# See eccf-frontend CLAUDE.md Section 9 for secret handling rules.

# ---------------------------------------------------------------------------
# Sanity — Public (safe to expose to browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=ynnot4j0
NEXT_PUBLIC_SANITY_DATASET=production

# ---------------------------------------------------------------------------
# Sanity — Server-side write token (NEVER prefix with NEXT_PUBLIC_)
# Generate at: https://sanity.io/manage → project → API → Tokens
# Required permissions: Editor
# ---------------------------------------------------------------------------
SANITY_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# NextAuth — Server-side only (NEVER prefix with NEXT_PUBLIC_)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Flutterwave — Server-side only (NEVER prefix with NEXT_PUBLIC_)
# Keys available at: https://dashboard.flutterwave.com
# ---------------------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=
# Public key IS safe for the browser (used in checkout modal)
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Multi-Platform Podcast & Sermon Sync (ADR-002)
# ---------------------------------------------------------------------------
SPOTIFY_RSS_URL=
YOUTUBE_RSS_URL=

# Resend Email API Key (Get free at resend.com)
RESEND_API_KEY="re_..."
NOTIFY_EMAIL="admin@eccf.com"

# ---------------------------------------------------------------------------
# Exco Dashboard — local development switches (ignored in production)
# ---------------------------------------------------------------------------
# 1 = use a mock session (role picked via the eccf-dev-role cookie, default admin)
# until NextAuth is configured. Never takes effect when NODE_ENV=production.
DASHBOARD_MOCK_AUTH=1
# mock | sanity — defaults to mock in development, sanity in production
DASHBOARD_DATA_SOURCE=mock
# Optional: empty | error | slow — exercise dashboard UI states with mock data
DASHBOARD_MOCK_STATE=
